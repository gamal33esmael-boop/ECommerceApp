@model ECommerceApp.ViewModel.DashBoardVm

<div class="container mt-4">
    <h4>Admin Dashboard</h4>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card border-top border-primary border-3">
                <div class="card-body">
                    <p class="text-muted">Total Users</p>
                    <h2>@Model.ToTalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-top border-success border-3">
                <div class="card-body">
                    <p class="text-muted">Categories</p>
                    <h2>@Model.ToTalCategories</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-top border-warning border-3">
                <div class="card-body">
                    <p class="text-muted">Sales This Month</p>
                    <h2>@Model.TotalSalesThisMonth $</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Users -->
    <h6 class="mt-4">Recent Users</h6>
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Username</th>
                <th>Email</th>
                <th>Joined</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.RecentUsers)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.CreatedAt.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
</div>